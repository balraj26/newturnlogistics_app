# Expo inlines EXPO_PUBLIC_* vars at bundle time. Load order (later wins):
#   .env  <  .env.development | .env.production  <  .env.local / .env.*.local
#
#   .env                    shared, all modes (this file's non-URL values; copy to .env)
#   .env.development        local backend, Android emulator (http://10.0.2.2:8000) — committed
#   .env.production         https://api.newturnlogistics.com — committed
#   .env.development.local  YOUR overrides, gitignored — e.g. a physical device needs your
#                           machine's LAN IP: EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
#                           (backend must run with --host 0.0.0.0)
#
# See New Turn/CLAUDE.md for how to run the backend locally.

# Same Web OAuth client the backend verifies Google ID tokens against
# (backend/.env's GOOGLE_CLIENT_ID) — NOT the Android client. The Sign-In
# SDK is told to request a token audienced to this client so the backend's
# existing verify_oauth2_token() check needs no changes. Not a secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=704465725995-46dd1e77q0r54tuqc5g3oo92mfhhgmul.apps.googleusercontent.com
