# Copy to .env for local dev. Expo inlines EXPO_PUBLIC_* vars at bundle time.
# Point this at your machine's LAN IP (not localhost) when testing on a
# physical device or the Android emulator — see backend/CLAUDE.md for how
# to run the backend locally.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Same Web OAuth client the backend verifies Google ID tokens against
# (backend/.env's GOOGLE_CLIENT_ID) — NOT the Android client. The Sign-In
# SDK is told to request a token audienced to this client so the backend's
# existing verify_oauth2_token() check needs no changes. Not a secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=704465725995-46dd1e77q0r54tuqc5g3oo92mfhhgmul.apps.googleusercontent.com
